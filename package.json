{
  "name": "smartlaw-desktop",
  "version": "0.2.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm run tauri dev -w apps/desktop",
    "dev:server": "npm run dev -w apps/server",
    "build:desktop": "npm run tauri build -w apps/desktop",
    "tauri": "tauri",
    "build": "turbo build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "./scripts/migrate.sh",
    "migrate:dry-run": "./scripts/migrate.sh --dry-run",
    "migrate:profiles": "npx tsx scripts/migrate-profiles.ts",
    "dev": "./dev.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "turbo": "latest",
    "typescript-eslint": "^8.69.0"
  }
}
