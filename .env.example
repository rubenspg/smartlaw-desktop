DB_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://smartlaw:change-me-strong-password@localhost:5432/smartlaw

# Obrigatório, mínimo 32 caracteres — o servidor não sobe sem isto.
JWT_SECRET=change-me-at-least-32-chars-long-secret

# Porta do servidor da API (padrão 3001).
PORT=3001

DATAJUD_API_KEY=your-datajud-api-key

# Google AI (Gemini) para o "Resumo do dia" da tela inicial e os resumos de
# Insights. Opcional: sem a chave, a tela mostra o texto calculado.
# GOOGLE_API_KEY=
# GOOGLE_AI_MODEL=gemini-3.5-flash-lite
