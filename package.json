{
  "name": "smartlaw-desktop",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm run tauri dev -w apps/desktop",
    "dev:server": "npm run dev -w apps/server",
    "build": "turbo build",
    "migrate": "./scripts/migrate.sh",
    "migrate:dry-run": "./scripts/migrate.sh --dry-run",
    "migrate:profiles": "npx tsx scripts/migrate-profiles.ts",
    "dev": "./dev.sh",
    "dev:server-only": "./dev.sh --no-desktop"
  },
  "devDependencies": {
    "turbo": "latest"
  }
}
