# Server configuration
NODE_ENV=development

# Database
DATABASE_URL=postgresql://smartlaw:smartlaw-pass@localhost:5432/smartlaw

# Auth
JWT_SECRET=change-me-at-least-32-chars-long-secret

# Datajud API (CNJ). Chave pública publicada em datajud-wiki.cnj.jus.br/api-publica/acesso —
# não é segredo, mas o CNJ pode trocá-la; a firma pode sobrescrever em Configurações.
DATAJUD_API_KEY=cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw==

# DJEN (intimações). Só responde a IPs brasileiros. `direct` (padrão) chama
# comunicaapi.pje.jus.br direto — na produção o LXC 103 sai pelo túnel do
# roteador; em dev fora do Brasil as rodadas terminam como GEOBLOQUEADO.
# `relay` repassa a um proxy no Brasil (só se o arranjo do roteador acabar).
DJEN_TRANSPORT=direct
# BR_RELAY_URL=https://relay.exemplo.com.br
# BR_RELAY_TOKEN=

# Google AI (Gemini) para o "Resumo do dia" da tela inicial e os resumos
# semanais de Insights. Opcional: sem a chave, a tela mostra o texto calculado.
# Só agregados são enviados (services/resumo/dia.ts, services/insights/semana.ts);
# a chave nunca sai do servidor.
# GOOGLE_API_KEY=
# GOOGLE_AI_MODEL=gemini-3.5-flash-lite

# Server URL (used by desktop in dev)
API_URL=http://localhost:3001

# Optional: override CSV path for db:seed
# CSV_DATA_DIR=/absolute/path/to/dados_sistema/dados_csv
